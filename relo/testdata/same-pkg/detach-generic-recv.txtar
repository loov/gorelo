# Detach a method from a generic type.

List#First=!

-- input/go.mod --
module example.com/pkg

go 1.21
-- input/list.go --
package pkg

type List[E any] []E

func (l List[E]) First() E { return l[0] }

func use(l List[int]) int { return l.First() }
-- golden/list.go --
package pkg

type List[E any] []E

func First[E any](l List[E]) E { return l[0] }

func use(l List[int]) int { return First(l) }
