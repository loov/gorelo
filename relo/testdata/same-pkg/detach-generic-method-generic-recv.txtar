# Go 1.27: detach a generic method from a generic type. The method's
# own type parameters come first so explicit instantiations at call
# sites remain valid; the receiver's are inferred from the argument.

List#Apply=!

-- input/go.mod --
module example.com/pkg

go 1.27
-- input/list.go --
package pkg

import "strconv"

type List[E any] []E

func (l List[E]) Apply[F any](f func(E) F) List[F] {
	r := make(List[F], len(l))
	for i, x := range l {
		r[i] = f(x)
	}
	return r
}

func use(l List[int]) {
	_ = l.Apply(strconv.Itoa)
	_ = l.Apply[string](strconv.Itoa)
}
-- golden/list.go --
package pkg

import "strconv"

type List[E any] []E

func Apply[F any, E any](l List[E], f func(E) F) List[F] {
	r := make(List[F], len(l))
	for i, x := range l {
		r[i] = f(x)
	}
	return r
}

func use(l List[int]) {
	_ = Apply(l, strconv.Itoa)
	_ = Apply[string](l, strconv.Itoa)
}
